#!/usr/bin/env bash
set -euo pipefail

hostname=${1:?Usage: $0 <host>}
echo "Using ${hostname} for the VM test."

# shellcheck source=scripts/lib/private.sh
source "$(dirname "$0")/lib/private.sh"
private_prepare "$hostname"

nix run -L ".#nixosConfigurations.${hostname}.config.system.build.vmWithDisko" "${PRIVATE_ARGS[@]}"

echo "Clean-up"
if [ -f "${hostname}-efi-vars.fd" ]; then
	rm "${hostname}-efi-vars.fd"
fi

if [ -f "${hostname}.qcow2" ]; then
	rm "${hostname}.qcow2"
fi

if [ -f result ]; then
	rm result
fi

echo "Done"
