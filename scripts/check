#!/usr/bin/env bash
set -euo pipefail

echo "Checking .sops.yaml is generated"
scripts/sops-config --check

# Host configs need the private input (scripts/rebuild <host> build); lint checks only.
echo "Running flake lint checks"
nix build -L --no-link .#checks.x86_64-linux.{format,statix,deadnix,shellcheck}

echo "All checks passed"
