#!/usr/bin/env bash
# scripts/rebuild <host> [switch|boot|test|build|dry-run] [extra nixos-rebuild args]
set -euo pipefail

if [[ $# -lt 1 ]]; then
	echo "Usage: $0 <host> [action] [args...]"
	exit 1
fi

HOST=$1
ACTION=${2:-switch}
shift $(($# < 2 ? $# : 2))

# shellcheck source=scripts/lib/private.sh
source "$(dirname "$0")/lib/private.sh"
private_prepare "$HOST"

sudo nixos-rebuild "$ACTION" --flake ".#$HOST" "${PRIVATE_ARGS[@]}" "$@"
