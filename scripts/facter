#!/usr/bin/env bash
# scripts/facter <host> — generate this machine's nixos-facter report and
# encrypt it to nixos/hosts/<host>/hardware.json.sops (read by scripts/rebuild).
set -euo pipefail

HOST=${1:?Usage: $0 <host>}
REPO=$(git rev-parse --show-toplevel)
OUT="$REPO/nixos/hosts/$HOST/hardware.json.sops"

[ -d "$REPO/nixos/hosts/$HOST" ] || {
	echo "unknown host: $HOST" >&2
	exit 1
}

FACTER=$(nix build --no-link --print-out-paths nixpkgs#nixos-facter)/bin/nixos-facter

# Plaintext stays on tmpfs; encrypting needs only the recipients' public keys.
TMP=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/facter.XXXXXX")
trap 'sudo rm -rf "$TMP"' EXIT
sudo "$FACTER" -o "$TMP/hardware.json"
sudo cat "$TMP/hardware.json" |
	sops encrypt --input-type binary --output-type binary \
		--filename-override "$OUT" /dev/stdin >"$OUT.tmp"
mv "$OUT.tmp" "$OUT"

echo "Wrote $OUT"
